# Supply an SSH host or alias; no host is selected by this file.
DOC2MD_OCR_HOST=
# Absolute remote workspace, containing scripts/ and models/Unlimited-OCR/.
# Not an account home. No spaces, shell syntax, or parent traversal.
DOC2MD_OCR_HOME=
DOC2MD_OCR_IMAGE=ocr-docs:local
DOC2MD_MIN_AVAIL_GIB=32
# Optional absolute executable path for minimal-environment callers.
DOC2MD_MARKITDOWN=
